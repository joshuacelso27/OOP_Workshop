<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16" styleClass="auth-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.inventory.controller.AuthController">
    <padding>
        <Insets bottom="34" left="42" right="42" top="34"/>
    </padding>

    <Label styleClass="title" text="Inventory Login"/>
    <Label styleClass="subtitle" text="Sign in to manage stock records"/>

    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>

    <Button maxWidth="Infinity" onAction="#handleLogin" text="Login"/>
    <Button maxWidth="Infinity" onAction="#goToSignup" styleClass="secondary-button" text="Create account"/>
    <Label fx:id="messageLabel" styleClass="message"/>
</VBox>
